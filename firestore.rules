rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private financial data. Each user can access only their own root document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared category names only; never store financial records in this document.
    match /sharedSettings/categoryCatalog {
      allow read, write: if request.auth != null;
    }
  }
}
